# --- Server ---
APP_SERVER__PORT=8002
APP_SERVER__MODE=debug
APP_SERVER__SHUTDOWN_TIMEOUT=15s
APP_SERVER__READ_HEADER_TIMEOUT=5s
APP_SERVER__READ_TIMEOUT=30s
APP_SERVER__WRITE_TIMEOUT=30s
APP_SERVER__IDLE_TIMEOUT=120s
APP_SERVER__BODY_LIMIT_BYTES=1048576
APP_SERVER__HANDLER_TIMEOUT=30s
# Comma-separated CIDRs of trusted L7 proxies (required if behind LB for ClientIP)
# APP_SERVER__TRUSTED_PROXIES=10.0.0.0/8

# --- MongoDB ---
APP_MONGO__URI=mongodb://localhost:27017
APP_MONGO__DATABASE=go_mongo_boilerplate

# --- Kafka ---
APP_KAFKA__BROKERS=localhost:9092
APP_KAFKA__GROUP_ID=go-mongo-worker
APP_KAFKA__TOPIC=user-events
APP_KAFKA__CONSUMER__MAX_RETRIES=3
APP_KAFKA__CONSUMER__RETRY_BACKOFF_BASE=1s
APP_KAFKA__CONSUMER__RETRY_BACKOFF_MAX=5m

# --- Redis (optional) ---
APP_REDIS__ADDR=localhost:6379

# --- Logger ---
APP_LOGGER__LEVEL=info
APP_LOGGER__FORMAT=json

# --- Observability (OTel → SigNoz) ---
# Local: enabled=true, insecure=true, ingestion_key empty
# SigNoz Cloud: insecure=false, endpoint=ingest.<region>.signoz.cloud:443, ingestion_key set
APP_OBSERVABILITY__ENABLED=false
APP_OBSERVABILITY__ENDPOINT=localhost:4317
APP_OBSERVABILITY__INSECURE=true
APP_OBSERVABILITY__INGESTION_KEY=
APP_OBSERVABILITY__SERVICE_NAME=go-mongo-boilerplate
APP_OBSERVABILITY__ENVIRONMENT=local
APP_OBSERVABILITY__SAMPLE_RATIO=1.0
APP_OBSERVABILITY__PUBLIC_FACING=false

# --- CORS ---
# Comma-separated list, do NOT use '*' if allow_credentials=true (rejected at boot)
# APP_CORS__ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
APP_CORS__ALLOW_CREDENTIALS=false

# --- Worker ---
APP_WORKER__SHUTDOWN_TIMEOUT=30s
APP_WORKER__HEALTH_PORT=8081

# --- Rate limit ---
APP_RATE_LIMIT__PER_IP__RPS=100
APP_RATE_LIMIT__PER_IP__BURST=200
APP_RATE_LIMIT__GLOBAL__RPS=10000
APP_RATE_LIMIT__GLOBAL__BURST=20000

# --- HTTP client (outbound) ---
APP_HTTP_CLIENT__TIMEOUT=10s
APP_HTTP_CLIENT__MAX_IDLE_CONNS=100
APP_HTTP_CLIENT__MAX_REDIRECTS=5

# --- SQS (optional second broker) ---
APP_SQS__REGION=us-east-1
# Override AWS endpoint for LocalStack dev:
# APP_SQS__ENDPOINT=http://localhost:4566
APP_SQS__CONSUMER__QUEUE_URL=
# AWS creds come from default chain (env / ~/.aws / IAM role). For LocalStack:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_REGION=us-east-1

# --- Migration runner (standalone, no APP_ prefix) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=go_mongo_boilerplate

# --- Config file (override default) ---
CONFIG_PATH=config/config.yaml
